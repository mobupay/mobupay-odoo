<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Odoo 20 : plus de champ `state`, et les moyens de paiement appartiennent a
        LEUR fournisseur (`payment.method.provider_id`, contrainte d'unicite
        `(provider_id, code)`, odoo/odoo#258854) : le coeur ne fournit plus
        `payment.payment_method_card`. La carte de Mobupay est donc declaree dans
        `payment_method_data.xml`, APRES le fournisseur qu'elle reference.

        NON PUBLIE a l'installation : un fournisseur de paiement ne doit JAMAIS
        s'installer pret a encaisser. Le marchand renseigne sa cle, verifie la
        connexion, puis publie sciemment.
    -->
    <record id="payment_provider_mobupay" model="payment.provider">
        <field name="name">Mobupay</field>
        <field name="code">mobupay</field>
        <field name="image_128" type="bytes" file="mobupay_payment/static/description/icon.png"/>
        <field name="redirect_form_view_id" ref="mobupay_payment.redirect_form"/>
        <field name="is_published">False</field>
        <field name="allow_tokenization">False</field>
    </record>
</odoo>
